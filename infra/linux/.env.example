GEORAEPLAN_ROOT_PATH=/srv/georaeplan
HOST_BIND_IP=127.0.0.1
POSTGRES_DB=georaeplan
POSTGRES_USER=georaeplan
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_DB_PASSWORD
POSTGRES_HOST_PORT=15434
ITWORLD_POSTGRES_DB=georaeplan_itworld
API_HOST_PORT=18082

# Linux PC SSH deployment target
LINUX_SSH_HOST=192.168.0.199
LINUX_SSH_PORT=2222
LINUX_SSH_USER=itw
LINUX_REMOTE_OPS_PATH=/srv/georaeplan/ops

JWT_ISSUER=georaeplan
JWT_AUDIENCE=georaeplan-client
JWT_SIGNING_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_JWT_SIGNING_KEY
JWT_EXPIRATION_MINUTES=43200
PUBLIC_BASE_URL=https://trade.2884.kr
TZ=Asia/Seoul

# Security hardening
SECURITY_ENABLE_RATE_LIMITING=true
SECURITY_LOGIN_PERMIT_LIMIT_PER_MINUTE=10
SECURITY_API_PERMIT_LIMIT_PER_MINUTE=300
SECURITY_ADD_SECURITY_HEADERS=true
SECURITY_REQUIRE_HTTPS_FORWARDED_PROTO=true
SECURITY_ALLOW_ANY_CORS_ORIGIN=false
SECURITY_ALLOWED_CORS_ORIGIN_0=

# Client compatibility starts in observation-only mode. Do not switch to
# StrictBlock until both released clients send identity headers, recovery from
# HTTP 426 has been verified, and every value below matches the published
# stable manifest. Enabling an incomplete policy intentionally fails startup.
CLIENT_COMPATIBILITY_MODE=AuditOnly
CLIENT_COMPATIBILITY_DESKTOP_ENABLED=false
CLIENT_COMPATIBILITY_DESKTOP_APP_ID=kr.georaeplan.desktop
CLIENT_COMPATIBILITY_DESKTOP_PLATFORM=windows
CLIENT_COMPATIBILITY_DESKTOP_POLICY_VERSION=1
CLIENT_COMPATIBILITY_DESKTOP_REQUIRES_USER_ACTION=true
CLIENT_COMPATIBILITY_DESKTOP_MINIMUM_VERSION=
CLIENT_COMPATIBILITY_DESKTOP_MINIMUM_BUILD=
CLIENT_COMPATIBILITY_DESKTOP_MINIMUM_PROTOCOL_VERSION=
CLIENT_COMPATIBILITY_DESKTOP_LATEST_VERSION=
CLIENT_COMPATIBILITY_DESKTOP_LATEST_BUILD=
CLIENT_COMPATIBILITY_DESKTOP_UPDATE_URL=/updates/manifest?channel=stable
CLIENT_COMPATIBILITY_DESKTOP_UPGRADE_TOKEN=georaeplan-client
CLIENT_COMPATIBILITY_ANDROID_ENABLED=false
CLIENT_COMPATIBILITY_ANDROID_APP_ID=kr.georaeplan.mobile
CLIENT_COMPATIBILITY_ANDROID_PLATFORM=android
CLIENT_COMPATIBILITY_ANDROID_POLICY_VERSION=1
CLIENT_COMPATIBILITY_ANDROID_REQUIRES_USER_ACTION=true
CLIENT_COMPATIBILITY_ANDROID_MINIMUM_VERSION=
CLIENT_COMPATIBILITY_ANDROID_MINIMUM_BUILD=
CLIENT_COMPATIBILITY_ANDROID_MINIMUM_PROTOCOL_VERSION=
CLIENT_COMPATIBILITY_ANDROID_LATEST_VERSION=
CLIENT_COMPATIBILITY_ANDROID_LATEST_BUILD=
CLIENT_COMPATIBILITY_ANDROID_UPDATE_URL=/updates/manifest?channel=stable
CLIENT_COMPATIBILITY_ANDROID_UPGRADE_TOKEN=georaeplan-client

# Seed user passwords: blank, CHANGE_THIS_*, or __DISABLE__ means skip creation/update
SEED_USERS_ENABLE_SEED_USERS=true
SEED_USERS_ADMIN_PASSWORD=
SEED_USERS_USER_PASSWORD=
SEED_USERS_ITW_PASSWORD=
SEED_USERS_UPDATE_EXISTING_ITW_PASSWORD=true
SEED_USERS_WARN_ON_DEFAULT_PASSWORDS=true

# Routine ops checks / backup / certificate
DAILY_CHECKS_ENABLED=true
WEEKLY_CHECKS_ENABLED=true
BACKUP_CREATE_ENABLED=true
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=36
FILE_EXPORT_ENABLED=true
EXTERNAL_REPLICA_ENABLED=false
EXTERNAL_REPLICA_PATH=
EXTERNAL_REPLICA_MIN_AGE_DAYS=1
FILE_STORAGE_SOURCE_PATH=/srv/georaeplan/storage/files
CERT_RENEW_ENABLED=false
CERT_RENEW_BEFORE_DAYS=30
