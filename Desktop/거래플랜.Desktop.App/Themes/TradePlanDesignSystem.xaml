<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 기존 거래플랜 다크 테마의 색상만 역할별 토큰으로 정리한다. -->
    <SolidColorBrush x:Key="TradePlanWindowBackgroundBrush" Color="#151F2E"/>
    <SolidColorBrush x:Key="TradePlanSurfaceBrush" Color="#1A2B4A"/>
    <SolidColorBrush x:Key="TradePlanSurfaceDarkBrush" Color="#102039"/>
    <SolidColorBrush x:Key="TradePlanBorderBrush" Color="#2E4060"/>
    <SolidColorBrush x:Key="TradePlanTextBrush" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="TradePlanMutedTextBrush" Color="#9FB3C8"/>
    <SolidColorBrush x:Key="TradePlanAccentBrush" Color="#4FC3F7"/>
    <SolidColorBrush x:Key="TradePlanPrimaryBrush" Color="#1B5E20"/>
    <SolidColorBrush x:Key="TradePlanEditBrush" Color="#1565C0"/>
    <SolidColorBrush x:Key="TradePlanSecondaryBrush" Color="#435A72"/>
    <SolidColorBrush x:Key="TradePlanDangerBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="TradePlanPrintBrush" Color="#546E7A"/>

    <Style x:Key="TradePlanHeaderPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TradePlanSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TradePlanBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="TradePlanSubToolbarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TradePlanSurfaceDarkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TradePlanBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style x:Key="TradePlanWindowTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TradePlanAccentBrush}"/>
        <Setter Property="FontFamily" Value="Malgun Gothic"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="TradePlanWindowSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TradePlanMutedTextBrush}"/>
        <Setter Property="FontFamily" Value="Malgun Gothic"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TradePlanToolbarLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TradePlanMutedTextBrush}"/>
        <Setter Property="FontFamily" Value="Malgun Gothic"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TradePlanActionButtonBaseStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource TradePlanSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="#5D7593"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="104"/>
        <Setter Property="FontFamily" Value="Malgun Gothic"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ActionBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ActionBorder" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ActionBorder" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{StaticResource TradePlanAccentBrush}"/>
                            <Setter TargetName="ActionBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#7F93AA"/>
                            <Setter TargetName="ActionBorder" Property="Background" Value="#2B3D54"/>
                            <Setter TargetName="ActionBorder" Property="BorderBrush" Value="#40556F"/>
                            <Setter TargetName="ActionBorder" Property="Opacity" Value="0.78"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TradePlanPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TradePlanActionButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource TradePlanPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TradePlanPrimaryBrush}"/>
    </Style>

    <Style x:Key="TradePlanEditButtonStyle" TargetType="Button" BasedOn="{StaticResource TradePlanActionButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource TradePlanEditBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TradePlanEditBrush}"/>
    </Style>

    <Style x:Key="TradePlanSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TradePlanActionButtonBaseStyle}"/>

    <Style x:Key="TradePlanDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource TradePlanActionButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource TradePlanDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TradePlanDangerBrush}"/>
    </Style>

    <Style x:Key="TradePlanPrintButtonStyle" TargetType="Button" BasedOn="{StaticResource TradePlanActionButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource TradePlanPrintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TradePlanBorderBrush}"/>
    </Style>

    <Style x:Key="TradePlanCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource TradePlanSecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
</ResourceDictionary>
