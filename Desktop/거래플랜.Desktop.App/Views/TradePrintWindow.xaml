<Window x:Class="거래플랜.Desktop.App.Views.TradePrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:거래플랜.Desktop.App.Infrastructure"
        Title="거래플랜 인쇄"
        Width="780"
        Height="500"
        MinWidth="720"
        MinHeight="480"
        infra:ResponsiveWindowBehavior.IsGlobalLayoutExcluded="True"
        infra:ResponsiveWindowBehavior.IsEnabled="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#151F2E"
        FontFamily="맑은 고딕">
    <Window.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A2B4A"/>
            <Setter Property="BorderBrush" Value="#2E4060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A7D1FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CompactPrinterItemStyle"
               TargetType="ComboBoxItem"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="PrintDialogRoot" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0B2036"
                BorderBrush="#2E4060"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,8">
            <TextBlock Text="거래플랜 전용 인쇄"
                       Foreground="#EAF2FF"
                       FontSize="20"
                       FontWeight="Bold"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="프린터" Style="{StaticResource SectionTitleStyle}"/>

                <ComboBox x:Name="PrinterComboBox"
                          Grid.Row="1"
                          Height="34"
                          MinHeight="34"
                          MaxDropDownHeight="224"
                          ItemContainerStyle="{StaticResource CompactPrinterItemStyle}"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          infra:FullTextLayoutBehavior.PreserveSingleLine="True"
                          SelectionChanged="OnPrinterSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding QueueName, Mode=OneWay}"
                                       infra:FullTextLayoutBehavior.PreserveSingleLine="True"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid x:Name="PrinterActionGrid" Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PropertiesButton"
                            Grid.Column="0"
                            Content="속성..."
                            MinHeight="34"
                            Margin="0,0,6,0"
                            Click="OnPrinterPropertiesClick"/>
                    <Button x:Name="OpenPrinterManagementButton"
                            Grid.Column="1"
                            Content="프린터 관리"
                            MinHeight="34"
                            Margin="0,0,6,0"
                            Click="OnOpenPrinterManagementClick"/>
                    <Button x:Name="RefreshPrintersButton"
                            Grid.Column="2"
                            Content="새로고침"
                            MinHeight="34"
                            Click="OnRefreshPrintersClick"/>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="PrintOptionsGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="페이지" Style="{StaticResource SectionTitleStyle}"/>
                    <RadioButton x:Name="AllPagesRadioButton"
                                 Content="모든 페이지"
                                 GroupName="PageMode"
                                 Foreground="#EAF2FF"
                                 IsChecked="True"
                                 Checked="OnPageModeChecked"
                                 Margin="0,0,0,6"/>
                    <RadioButton x:Name="CurrentPageRadioButton"
                                 Content="현재 페이지"
                                 GroupName="PageMode"
                                 Foreground="#EAF2FF"
                                 Checked="OnPageModeChecked"
                                 Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="PageRangeRadioButton"
                                     Grid.Column="0"
                                     Content="페이지:"
                                     GroupName="PageMode"
                                     Foreground="#EAF2FF"
                                     VerticalAlignment="Center"
                                     Checked="OnPageModeChecked"/>
                        <TextBox x:Name="PageRangeTextBox"
                                 Grid.Column="1"
                                 Height="30"
                                 MinWidth="0"
                                 Margin="8,0,0,0"
                                 IsEnabled="False"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="PageHelpTextBlock"
                               Text="페이지 번호나 범위를 쉼표로 구분하세요. 예: 1,3,5-12"
                               Foreground="#A7D1FF"/>
                    <TextBlock x:Name="PageCountTextBlock"
                               Foreground="#6FD3FF"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="인쇄 매수" Style="{StaticResource SectionTitleStyle}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="인쇄 매수" Style="{StaticResource LabelStyle}" Width="76"/>
                        <TextBox x:Name="CopyCountTextBox"
                                 Width="80"
                                 Height="30"
                                 MinWidth="0"
                                 Text="1"
                                 TextAlignment="Right"
                                 VerticalContentAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                            <Button Content="▲"
                                    AutomationProperties.Name="인쇄 매수 증가"
                                    Style="{DynamicResource TradePlanCompactButtonStyle}"
                                    Width="34"
                                    Height="24"
                                    Padding="0"
                                    Margin="0,0,4,0"
                                    Click="OnCopyCountIncreaseClick"/>
                            <Button Content="▼"
                                    AutomationProperties.Name="인쇄 매수 감소"
                                    Style="{DynamicResource TradePlanCompactButtonStyle}"
                                    Width="34"
                                    Height="24"
                                    Padding="0"
                                    Click="OnCopyCountDecreaseClick"/>
                        </StackPanel>
                    </StackPanel>
                    <CheckBox x:Name="CollateCheckBox"
                              Grid.Row="2"
                              Content="한 부씩 인쇄"
                              Foreground="#EAF2FF"
                              IsChecked="True"
                              Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="PrintActionFooter"
                Grid.Row="3"
                Background="#122038"
                BorderBrush="#2E4060"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="PDF 저장"
                        Style="{DynamicResource TradePlanPrintButtonStyle}"
                        Margin="0,0,6,0"
                        Click="OnSavePdfClick"/>
                <Button Grid.Column="1"
                        Content="파일 저장(XPS)"
                        Style="{DynamicResource TradePlanPrintButtonStyle}"
                        Margin="0,0,6,0"
                        Click="OnSaveFileClick"/>
                <Button x:Name="PrintButton"
                        Grid.Column="2"
                        Content="인쇄"
                        Style="{DynamicResource TradePlanPrintButtonStyle}"
                        Margin="0,0,6,0"
                        IsDefault="True"
                        Click="OnOkClick"/>
                <Button Grid.Column="3"
                        Content="취소"
                        Style="{DynamicResource TradePlanSecondaryButtonStyle}"
                        IsCancel="True"
                        Click="OnCancelClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
