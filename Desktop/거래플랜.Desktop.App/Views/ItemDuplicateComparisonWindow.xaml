<Window x:Class="거래플랜.Desktop.App.Views.ItemDuplicateComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="품목 중복 후보 비교" Width="1560" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#0B1628" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="Foreground" Value="#DDEBFF"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource TradePlanSecondaryButtonStyle}">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowBackground" Value="#E6F0FA"/>
            <Setter Property="AlternatingRowBackground" Value="#D4E2F0"/>
            <Setter Property="Foreground" Value="#071222"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#20344F"/>
            <Setter Property="Foreground" Value="#66D9FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Border" x:Key="PanelBorder">
            <Setter Property="Background" Value="#14243A"/>
            <Setter Property="BorderBrush" Value="#2A4666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="품목 중복 후보 비교" FontSize="30" FontWeight="Bold" Foreground="#5BD4FF"/>
                    <TextBlock Text="후보별 업무 필드와 참조 영향을 확인하고, 안전 조건을 모두 통과한 경우에만 대표 품목을 직접 선택해 병합합니다."
                               FontSize="15" Foreground="#B8C7D8" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="닫기(F12)" Style="{StaticResource TradePlanSecondaryButtonStyle}"
                        VerticalAlignment="Center" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding Comparison.SummaryText}" FontSize="14" Foreground="#DDEBFF" TextWrapping="Wrap"/>
                <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Review.BlockingReasonText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#FFD56B" TextWrapping="Wrap"/>
                </ScrollViewer>
                <TextBlock Text="비교 화면을 여는 것만으로는 데이터가 변경되지 않습니다. 충돌 항목이 있거나 동기화 상태가 바뀌면 병합은 실행되지 않습니다."
                           FontSize="13" Foreground="#FF9D9D" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
            <DataGrid x:Name="CandidateGrid"
                      ItemsSource="{Binding Comparison.Candidates}"
                      SelectionChanged="CandidateGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="대표 추천" Binding="{Binding RecommendationText}" Width="250"/>
                    <DataGridTextColumn Header="후보 ID" Binding="{Binding ItemId, StringFormat={}{0:N}}" Width="270"/>
                    <DataGridTextColumn Header="품목 / 규격" Binding="{Binding NameAndSpecification}" Width="240"/>
                    <DataGridTextColumn Header="범위" Binding="{Binding ScopeText}" Width="160"/>
                    <DataGridTextColumn Header="분류·유형·단위" Binding="{Binding MasterDataSummary}" Width="300"/>
                    <DataGridTextColumn Header="재고" Binding="{Binding StockSummary}" Width="190"/>
                    <DataGridTextColumn Header="참조 영향" Binding="{Binding ReferenceSummary}" Width="420"/>
                    <DataGridTextColumn Header="자산별 필드" Binding="{Binding AssetDataSummary}" Width="420"/>
                    <DataGridTextColumn Header="동기화 상태" Binding="{Binding SyncStateText}" Width="230"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="선택 후보" Foreground="#8FB6D8" FontWeight="Bold" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding SelectedCandidate.NameAndSpecification}" Foreground="#EAF4FF" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedCandidate.ReferenceSummary}" Foreground="#B8C7D8" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding SelectedCandidate.AssetDataSummary}" Foreground="#FFD56B" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionStatusText" VerticalAlignment="Center" Foreground="#B8C7D8"
                       Text="비교할 후보 행을 선택하세요."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OpenSelectedItemButton" Content="선택 품목 화면 열기"
                        Style="{StaticResource TradePlanEditButtonStyle}" Click="OpenSelectedItemButton_Click" IsEnabled="False"/>
                <Button x:Name="MergeSelectedButton" Content="선택 품목을 대표로 병합"
                        Style="{StaticResource TradePlanDangerButtonStyle}" Click="MergeSelectedButton_Click" IsEnabled="False"/>
                <Button Content="닫기" Style="{StaticResource TradePlanSecondaryButtonStyle}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
