            <Border Grid.Column="2" Background="#1A2B4A" CornerRadius="6" BorderBrush="#2E4060" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="렌탈 청구 상세" Foreground="#4FC3F7" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Border Background="#263A55"
                                BorderBrush="#4FC3F7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,10"
                                Visibility="{Binding IsCustomerGroupSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Content="{Binding SelectedCustomerGroupToggleLabel}"
                                            Style="{StaticResource TradePlanEditButtonStyle}"
                                            Command="{Binding ExpandSelectedSummaryCommand}"
                                            IsEnabled="{Binding CanExpandSelectedSummary}"
                                            MinWidth="112"
                                            Margin="10,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="거래처 청구주기" Foreground="#4FC3F7" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedGroupCycleSummary}"
                                                   Foreground="#EAF2FF"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="이 행은 거래처별 요약입니다. 여러 청구 프로필의 실제 주기별 건수를 표시하며, 펼친 뒤 개별 프로필을 선택해 저장·삭제·장비연결·입금등록을 진행합니다."
                                           Foreground="#B3E5FC"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="통일할 주기(개월)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding GroupCycleTargetMonths, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalContentAlignment="Right"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="2"
                                            Content="선택 주기 통일"
                                            Style="{StaticResource TradePlanEditButtonStyle}"
                                            Command="{Binding UnifySelectedGroupCycleCommand}"
                                            IsEnabled="{Binding CanUnifySelectedGroupCycle}"
                                            Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding SelectedGroupCycleImpactText}"
                                               Foreground="#90CAF9"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#4A341F"
                                BorderBrush="#FFB74D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                Margin="0,0,0,10"
                                Visibility="{Binding SelectedRow.HasUnlinkedBillingAssets, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SelectedRow.BillingSetupHelpText}"
                                       Foreground="#FFE0B2"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Border Background="#223754" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="선택 청구 요약" Foreground="#4FC3F7" FontWeight="Bold"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="청구기간" Style="{StaticResource SelectedBillingMetricLabelStyle}"/>
                                        <TextBlock Text="{Binding SelectedRow.CurrentBillingPeriodLabel}" Style="{StaticResource SelectedBillingMetricValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="청구금액" Style="{StaticResource SelectedBillingMetricLabelStyle}"/>
                                        <TextBlock Text="{Binding SelectedRow.CurrentBilledAmount, StringFormat=N0}" Style="{StaticResource SelectedBillingMetricValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="누적수금" Style="{StaticResource SelectedBillingMetricLabelStyle}"/>
                                        <TextBlock Text="{Binding SelectedRow.SettledAmount, StringFormat=N0}" Style="{StaticResource SelectedBillingMetricValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                                        <TextBlock Text="미수금" Style="{StaticResource SelectedBillingMetricLabelStyle}"/>
                                        <TextBlock Text="{Binding SelectedRow.OutstandingAmount, StringFormat=N0}" Style="{StaticResource SelectedBillingMetricValueStyle}" Foreground="#FFCC80"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                                        <TextBlock Text="수금상태" Style="{StaticResource SelectedBillingMetricLabelStyle}"/>
                                        <TextBlock Text="{Binding SelectedRow.SettlementStatusDisplay}" Style="{StaticResource SelectedBillingMetricValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,10,0,0">
                                        <TextBlock Text="마지막수금일" Style="{StaticResource SelectedBillingMetricLabelStyle}"/>
                                        <TextBlock Text="{Binding SelectedRow.LastSettledDate}" Style="{StaticResource SelectedBillingMetricValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="입금은 '입금 등록' 또는 아래 '청구/입금 내역'의 월별 버튼에서 기록됩니다."
                                           Foreground="#90CAF9"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#4A341F"
                                BorderBrush="#FFB74D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                Margin="0,0,0,10"
                                Visibility="{Binding SelectedRowHasPastUnresolved, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SelectedPastUnresolvedSummaryText}"
                                       Foreground="#FFE0B2"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="청구/입금 내역" Foreground="#4FC3F7" FontWeight="Bold" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding BillingHistoryRows}"
                                  SelectedItem="{Binding SelectedBillingHistory}"
                                  PreviewMouseRightButtonDown="BillingHistoryDataGrid_PreviewMouseRightButtonDown"
                                  MouseDoubleClick="BillingHistoryDataGrid_MouseDoubleClick"
                                  ToolTip="행을 더블클릭하면 입력된 연결 전표 창을 엽니다."
                                  Height="155"
                                  Margin="0,0,0,10"
                                  IsReadOnly="True">
                            <DataGrid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="선택 내역 삭제"
                                              Command="{Binding DeleteSelectedBillingHistoryCommand}"
                                              IsEnabled="{Binding CanDeleteSelectedBillingHistory}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="청구기간" Binding="{Binding PeriodLabel}" Width="120"/>
                                <DataGridTextColumn Header="청구일" Binding="{Binding ScheduledDate, StringFormat={}{0:yyyy-MM-dd}}" Width="96"/>
                                <DataGridTextColumn Header="청구금액" Binding="{Binding BilledAmount, StringFormat=N0}" Width="92"/>
                                <DataGridTextColumn Header="입금액" Binding="{Binding SettledAmount, StringFormat=N0}" Width="86"/>
                                <DataGridTextColumn Header="미수금" Binding="{Binding OutstandingAmount, StringFormat=N0}" Width="86"/>
                                <DataGridTextColumn Header="입금일" Binding="{Binding SettledDate, StringFormat={}{0:yyyy-MM-dd}}" Width="96"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding SettlementStatus}" Width="84"/>
                                <DataGridTemplateColumn Header="작업" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding ActionLabel}"
                                                    Height="28"
                                                    MinWidth="76"
                                                    Padding="8,0"
                                                    Click="BillingHistoryRegisterButton_Click"
                                                    IsEnabled="{Binding CanRegisterSettlement}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid IsEnabled="{Binding CanEditBillingProfileDetails}">
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BillingDetailLabelStyle}"/>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>
                                <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="거래처명"/>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EditCustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="조회" MinWidth="72" Padding="10,0" Click="CustomerLookupButton_Click"/>
                            </Grid>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="상태"/>
                            <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding EditBillingStatus, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="설치위치"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditInstallLocation, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="사업자번호"/>
                            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding EditBusinessNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="담당지점"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding EditOfficeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding EditOfficeCode}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="이메일"/>
                            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="청구유형"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding BillingTypeOptions}" SelectedItem="{Binding EditBillingType}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="선불/후불"/>
                            <ComboBox Grid.Row="3" Grid.Column="4" ItemsSource="{Binding BillingAdvanceModeOptions}" SelectedItem="{Binding EditBillingAdvanceMode}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="청구일 유형"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding BillingDayModeOptions}" SelectedItem="{Binding EditBillingDayMode}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="청구일"/>
                            <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding EditBillingDay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsFixedBillingDayMode}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="청구 주기(개월)"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EditBillingCycleMonths, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="5" Grid.Column="3" Text="청구기간 시작월"/>
                            <ComboBox Grid.Row="5" Grid.Column="4" Style="{StaticResource BillingAnchorMonthComboBoxStyle}" ItemsSource="{Binding BillingAnchorMonthOptions}" SelectedItem="{Binding EditBillingAnchorMonth}" Margin="0,0,0,6">
                                <ComboBox.Resources>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="Black"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="계약 체결일"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,6">
                                <DatePicker SelectedDate="{Binding EditContractDate}" SelectedDateFormat="Short">
                                    <DatePicker.Resources>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource RentalDatePickerButtonStyle}"/>
                                    </DatePicker.Resources>
                                </DatePicker>
                                <TextBlock Text="{Binding ContractDateWarningMessage}"
                                           Foreground="#FFCC80"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ShouldShowContractDateWarning, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="6" Grid.Column="3" Text="월 기준금액"/>
                            <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding EditMonthlyAmount, StringFormat=N0}" IsReadOnly="True" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="서류 발송 규칙"/>
                            <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding DocumentIssueModeOptions}" SelectedItem="{Binding EditDocumentIssueMode}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="7" Grid.Column="3" Text="선행일수"/>
                            <TextBox Grid.Row="7" Grid.Column="4" Text="{Binding EditDocumentLeadDays, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDocumentLeadDaysVisible}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="청구방식" Margin="0,0,4,6"/>
                            <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding BillingMethodOptions}" SelectedItem="{Binding EditBillingMethod}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="8" Grid.Column="3" Text="제출서류" VerticalAlignment="Top" Margin="0,0,4,6"/>
                            <TextBox Grid.Row="8" Grid.Column="4" Text="{Binding EditSubmissionDocuments, UpdateSourceTrigger=PropertyChanged}" Height="66" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="메모" VerticalAlignment="Top" Margin="0,2,4,0"/>
                            <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" Height="66" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                        </Grid>

                        <WrapPanel Margin="0,10,0,10">
                            <Button Content="계약서 열기" Style="{StaticResource TradePlanSecondaryButtonStyle}" Command="{Binding OpenCustomerContractCommand}"/>
                        </WrapPanel>

                        <Border Background="#223754" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="표시품목 요약" Foreground="#4FC3F7" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TemplateSummary}" Margin="0,6,0,0"/>
                                <Border Background="#4A2F13"
                                        BorderBrush="#FFB74D"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding HasBillingAssetCoverageWarning, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding BillingAssetCoverageWarning}"
                                               Foreground="#FFCC80"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="{Binding BillingSchedulePreviewText}" Foreground="#B3E5FC" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Foreground="#80CBC4" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="전표 품명 미리보기: " FontWeight="Bold"/>
                                    <Run Text="{Binding InvoiceItemNamePreviewText}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding DocumentIssuePreviewText}" Foreground="#B3E5FC" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="모델별 자동 구성" Style="{StaticResource TradePlanEditButtonStyle}" Margin="8,0,0,6" Command="{Binding AutoGroupIndividualTemplateItemsByModelCommand}" ToolTip="개별 청구 자산을 모델별 표시품목으로 다시 구성합니다."/>
                                <Button x:Name="ToggleBillingDetailWidthButton" Content="상세 크게 보기" Style="{StaticResource TradePlanSecondaryButtonStyle}" Margin="8,0,0,6" Click="ToggleBillingDetailWidthButton_Click"/>
                            </WrapPanel>
                            <StackPanel>
                                <TextBlock Text="청구서 표시 품목" Foreground="#4FC3F7" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="전표/거래명세서 출력 라인을 먼저 확인하고, 선택한 행의 세부값은 아래에서 편집합니다." Foreground="#90CAF9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="표시 라인 추가" Style="{StaticResource TradePlanEditButtonStyle}" Margin="0,0,8,6" Command="{Binding AddTemplateItemCommand}" IsEnabled="{Binding CanSave}"/>
                            <Button Content="▲" Style="{StaticResource TradePlanCompactButtonStyle}" Margin="0,0,4,6" Command="{Binding MoveTemplateItemUpCommand}" ToolTip="선택한 표시 품목을 위로 이동"/>
                            <Button Content="▼" Style="{StaticResource TradePlanCompactButtonStyle}" Margin="0,0,8,6" Command="{Binding MoveTemplateItemDownCommand}" ToolTip="선택한 표시 품목을 아래로 이동"/>
                            <Button Content="선택 표시 라인 삭제" Style="{StaticResource TradePlanDangerButtonStyle}" Margin="0,0,8,6" Command="{Binding RemoveTemplateItemCommand}"/>
                            <Button Content="렌탈 자산연결" Style="{StaticResource TradePlanEditButtonStyle}" Margin="0,0,8,6" Click="OpenAssetLinkDialogButton_Click" IsEnabled="{Binding CanOpenAssetLinkDialog}"/>
                        </WrapPanel>

                        <DataGrid ItemsSource="{Binding TemplateItems}"
                                  SelectedItem="{Binding SelectedTemplateItem}"
                                  Height="168"
                                  Margin="0,0,0,10"
                                  IsReadOnly="True"
                                  FrozenColumnCount="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="그룹방식" Binding="{Binding IndividualGroupingMode}" Width="90"/>
                                <DataGridTextColumn Header="청구명" Binding="{Binding DisplayItemName}" Width="*" MinWidth="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding DisplayItemName}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="전표 품명" Binding="{Binding InvoiceItemNamePreview}" Width="1.35*" MinWidth="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding InvoiceItemNamePreview}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="수량" Binding="{Binding Quantity, StringFormat=N0}" Width="62"/>
                                <DataGridTextColumn Header="금액" Binding="{Binding Amount, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn Header="연결대수" Binding="{Binding IncludedAssetCountDisplay}" Width="76"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#223754" CornerRadius="6" Padding="10" Margin="0,0,0,10" IsEnabled="{Binding CanSave}">
                            <StackPanel>
                                <TextBlock Text="선택 표시품목 상세" Foreground="#4FC3F7" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="라인유형" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                              ItemsSource="{Binding BillingLineModeOptions}"
                                              SelectedItem="{Binding SelectedTemplateItem.BillingLineMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanEditTemplateLineMode}"
                                              Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="그룹방식" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding SelectedTemplateItem.IndividualGroupingMode}" IsReadOnly="True" Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="청구명" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTemplateItem.DisplayItemName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="전표 품명" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding SelectedTemplateItem.InvoiceItemNamePreview}" IsReadOnly="True" ToolTip="{Binding SelectedTemplateItem.InvoiceItemNamePreview}" Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="규격" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTemplateItem.Specification, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="단위" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding SelectedTemplateItem.Unit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="수량" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTemplateItem.Quantity, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="단가" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding SelectedTemplateItem.UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="금액" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTemplateItem.Amount, StringFormat=N0}" IsReadOnly="True" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="자재번호" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding SelectedTemplateItem.MaterialNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="대표자산" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding SelectedTemplateItem.RepresentativeAssetSummary}" IsReadOnly="True" Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="비고" VerticalAlignment="Top" Margin="0,6,6,0"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding SelectedTemplateItem.Note, UpdateSourceTrigger=PropertyChanged}" Height="52" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="청구유형이 묶음/개별이면 표시품목 라인유형이 같은 값으로 고정됩니다. 실제 청구/전표 대상 자산은 아래 목록에서만 결정됩니다."
                                   Foreground="#90CAF9" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <Expander Header="거래처 임대 자산 (렌탈 자산연결과 연동)" IsExpanded="True" Margin="0,0,0,10" IsEnabled="{Binding CanEditBillingProfileDetails}">
                            <StackPanel>
                                <WrapPanel Margin="0,8,0,8">
                                    <Button Content="대표자산 지정" Style="{StaticResource TradePlanEditButtonStyle}" Margin="0,0,8,0" Command="{Binding SetRepresentativeAssetCommand}" IsEnabled="{Binding CanSetRepresentativeAsset}"/>
                                    <Button Content="선택 장비를 현재 표시품목으로 이동" Style="{StaticResource TradePlanEditButtonStyle}" Margin="0,0,8,0" Command="{Binding AddSelectedIncludedAssetToTemplateItemCommand}" IsEnabled="{Binding CanAddSelectedIncludedAssetToTemplateItem}"/>
                                    <Button Content="선택 장비 연결 해제" Style="{StaticResource TradePlanDangerButtonStyle}" Margin="0,0,8,0" Command="{Binding RemoveIncludedAssetCommand}" IsEnabled="{Binding CanRemoveIncludedAsset}"/>
                                    <TextBlock Text="이 목록은 현재 청구 프로필에 연결된 렌탈 자산입니다. 연결 해제해도 자산 자체는 삭제되지 않으며 렌탈 자산 추가 후보로 돌아갑니다." Foreground="#90CAF9" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding RentalAssetEditPermissionNotice}"
                                           Foreground="#FFCC80"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>
                                <DataGrid ItemsSource="{Binding IncludedAssets}"
                                          SelectedItem="{Binding SelectedIncludedAsset}"
                                          IsReadOnly="{Binding IsRentalAssetSourceReadOnly}"
                                          PreviewMouseRightButtonDown="IncludedAssetsDataGrid_PreviewMouseRightButtonDown"
                                          ToolTip="행을 우클릭하면 해당 자산을 렌탈 자산/설치현황 창에서 바로 확인할 수 있습니다."
                                          Height="190"
                                          Margin="0,0,0,10">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="렌탈 자산/설치현황에서 열기"
                                                      Click="OpenIncludedAssetInRentalAssetWindowMenuItem_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="대표" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsRepresentativeAsset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              ToolTip="대표자산으로 지정합니다."/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="시리얼번호" Binding="{Binding MachineNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                        <DataGridTextColumn Header="품목분류" Binding="{Binding ItemCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                        <DataGridTextColumn Header="품명" Binding="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                        <DataGridTextColumn Header="제조사" Binding="{Binding Manufacturer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <DataGridTextColumn Header="월요금" Binding="{Binding MonthlyFee, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Width="90"/>
                                        <DataGridTextColumn Header="현재 거래처" Binding="{Binding CurrentCustomerName}" Width="160" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="설치위치" Binding="{Binding InstallLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                        <DataGridTextColumn Header="상태" Binding="{Binding AssetStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                        <DataGridTextColumn Header="청구상태" Binding="{Binding BillingEligibilityStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                        <DataGridTextColumn Header="비고" Binding="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                        <DataGridTextColumn Header="자산소속" Binding="{Binding AssetScopeDisplay}" Width="170" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="선택 장비 임대 이력" Foreground="#4FC3F7" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button Content="임대이력 추가" Style="{StaticResource TradePlanEditButtonStyle}" Margin="0,0,6,0" Command="{Binding AddIncludedAssetAssignmentHistoryCommand}" IsEnabled="{Binding CanAddIncludedAssetAssignmentHistory}"/>
                                        <Button Content="선택 이력 수정" Style="{StaticResource TradePlanEditButtonStyle}" Margin="0,0,6,0" Command="{Binding EditIncludedAssetAssignmentHistoryCommand}" IsEnabled="{Binding CanEditIncludedAssetAssignmentHistory}"/>
                                        <Button Content="선택 이력 삭제" Style="{StaticResource TradePlanDangerButtonStyle}" Command="{Binding DeleteIncludedAssetAssignmentHistoryCommand}" IsEnabled="{Binding CanDeleteIncludedAssetAssignmentHistory}"/>
                                    </WrapPanel>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding IncludedAssetAssignmentHistories}" SelectedItem="{Binding SelectedIncludedAssetAssignmentHistory}" Height="160" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="상태" Binding="{Binding StatusDisplay}" Width="90"/>
                                        <DataGridTextColumn Header="기간" Binding="{Binding PeriodDisplay}" Width="210"/>
                                        <DataGridTextColumn Header="거래처" Binding="{Binding CustomerName}" Width="160"/>
                                        <DataGridTextColumn Header="설치위치" Binding="{Binding InstallLocation}" Width="150"/>
                                        <DataGridTextColumn Header="청구연결" Binding="{Binding BillingProfileDisplay}" Width="180"/>
                                        <DataGridTextColumn Header="월요금" Binding="{Binding MonthlyFee, StringFormat=N0}" Width="90"/>
                                        <DataGridTextColumn Header="담당지점" Binding="{Binding ResponsibleOfficeName}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="4" Margin="0,10,0,0" Background="#122038" BorderBrush="#2E4060" BorderThickness="1" CornerRadius="6" Padding="10">
            <DockPanel LastChildFill="False">
                <ProgressBar Width="220" Height="12" IsIndeterminate="{Binding IsBusy}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#90CAF9" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
