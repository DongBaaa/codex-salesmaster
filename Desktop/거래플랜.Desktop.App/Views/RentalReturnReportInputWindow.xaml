<Window x:Class="거래플랜.Desktop.App.Views.RentalReturnReportInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="회수장비내역서 입력"
        Width="640"
        Height="420"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0F2138">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="회수장비내역서 추가 입력"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#5CD6FF"
                       Margin="0,0,0,6"/>
            <TextBlock Text="회수이유와 장애내용은 관리메모와 분리되어 이번 출력물에만 반영됩니다."
                       FontSize="13"
                       Foreground="#B8C7DC"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       ToolTip="회수이유와 장애내용은 관리메모와 분리되어 이번 출력물에만 반영됩니다."/>
        </StackPanel>

        <ScrollViewer x:Name="RentalReturnReportBodyScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="RentalReturnReportBodyContent"
                  MinWidth="500"
                  MinHeight="{Binding ViewportHeight, ElementName=RentalReturnReportBodyScrollViewer}"
                  Width="{Binding ViewportWidth, ElementName=RentalReturnReportBodyScrollViewer}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="회수이유"
                               Foreground="#EAF2FF"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="ReturnReasonBox"
                             Grid.Column="1"
                             Height="34"
                             Padding="8,5"
                             FontSize="14"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="장애내용"
                               Foreground="#EAF2FF"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="FaultDescriptionBox"
                             Grid.Row="1"
                             MinHeight="150"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="8"
                             FontSize="14"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <StackPanel x:Name="RentalReturnReportFooter"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="확인"
                    Style="{StaticResource TradePlanPrimaryButtonStyle}"
                    Width="110"
                    Height="36"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Confirm_Click"/>
            <Button Content="취소"
                    Style="{StaticResource TradePlanSecondaryButtonStyle}"
                    Width="110"
                    Height="36"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
