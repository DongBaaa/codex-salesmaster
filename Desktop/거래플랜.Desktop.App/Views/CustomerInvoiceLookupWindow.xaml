<Window x:Class="거래플랜.Desktop.App.Views.CustomerInvoiceLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:거래플랜.Desktop.App.Converters"
        Title="거래내역 조회"
        Width="1800"
        Height="860"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#151F2E"
        ResizeMode="CanResize"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <conv:NullableDateOnlyConverter x:Key="NullableDateOnlyConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="FontFamily" Value="맑은 고딕"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#D9E6F5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#4A6382"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="CopyableLookupTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style x:Key="CopyableLookupCustomerNameTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource CopyableLookupTextBoxStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CaretBrush" Value="#4FC3F7"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource TradePlanSecondaryButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#D9E6F5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#4A6382"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MaxWidth" Value="150"/>
            <Setter Property="CalendarStyle" Value="{StaticResource GeoraePlanDatePickerCalendarStyle}"/>
        </Style>
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Background" Value="#D9E6F5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,0,4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E2D40"/>
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="BorderBrush" Value="#2E4060"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2E4060"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AlternatingRowBackground" Value="#223754"/>
            <Setter Property="RowBackground" Value="#1E2D40"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
        </Style>
        <Style x:Key="InvoiceListCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A2B4A"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#2E4060"/>
        </Style>
        <Style x:Key="InvoiceListColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top"
                Background="#1A2B4A"
                BorderBrush="#2E4060"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="거래내역 조회"
                               Foreground="#4FC3F7"
                               FontSize="28"
                               FontWeight="Bold"/>
                    <TextBlock Text="메인 화면 조건을 바꾸지 않고 별도 창에서 거래처별 전표, 수금·지급 내역, 거래처 요약을 확인합니다."
                               Foreground="#B8C7D8"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#90CAF9"
                               FontSize="12"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="새로고침"
                            Style="{StaticResource TradePlanSecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="닫기(F12)"
                            Style="{StaticResource TradePlanSecondaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#1A2B4A"
                BorderBrush="#2E4060"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="조회 시작" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding FilterFrom, Converter={StaticResource NullableDateOnlyConverter}, Mode=TwoWay}"
                            SelectedDateFormat="Short"
                            Margin="0,0,12,0">
                    <DatePicker.Resources>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource UnifiedDatePickerButtonStyle}"/>
                    </DatePicker.Resources>
                </DatePicker>
                <TextBlock Text="조회 종료" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding FilterTo, Converter={StaticResource NullableDateOnlyConverter}, Mode=TwoWay}"
                            SelectedDateFormat="Short"
                            Margin="0,0,12,0">
                    <DatePicker.Resources>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource UnifiedDatePickerButtonStyle}"/>
                    </DatePicker.Resources>
                </DatePicker>
                <Button Content="기간 해제"
                        Style="{StaticResource TradePlanSecondaryButtonStyle}"
                        Command="{Binding ClearDateRangeCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="전체 거래처"
                        Style="{StaticResource TradePlanSecondaryButtonStyle}"
                        Command="{Binding ShowAllCommand}"
                        Margin="0,0,8,0"/>
                <Rectangle Width="1" Height="22" Fill="#3E5875" Margin="4,0,12,0" VerticalAlignment="Center"/>
                <Button Content="판매작성"
                        Style="{StaticResource TradePlanEditButtonStyle}"
                        Click="SalesEntryButton_Click"
                        Margin="0,0,6,0"/>
                <Button Content="구매작성"
                        Style="{StaticResource TradePlanEditButtonStyle}"
                        Click="PurchaseEntryButton_Click"
                        Margin="0,0,6,0"/>
                <Button Content="견적/발주"
                        Style="{StaticResource TradePlanEditButtonStyle}"
                        Click="ProcurementEntryButton_Click"
                        Margin="0,0,6,0"/>
                <Button Content="수금 입력"
                        Style="{StaticResource TradePlanEditButtonStyle}"
                        Click="PaymentEntryButton_Click"
                        Margin="0,0,6,0"/>
                <Button Content="전표 인쇄[F9]"
                        Style="{StaticResource TradePlanPrintButtonStyle}"
                        Click="PrintStatementButton_Click"
                        Margin="0,0,12,0"/>
                <TextBlock Text="기간을 비우면 전체 기간으로 조회합니다."
                           Foreground="#9FB3C8"
                           VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1A2B4A" CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#102039" CornerRadius="6,6,0,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="거래처 목록" Foreground="#4FC3F7" FontWeight="Bold"/>
                            <TextBox Text="{Binding CustomerFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,8,0,0"
                                     ToolTip="상호, 전화, 사업자번호, 담당자, 담당지점, 메모로 검색합니다."/>
                            <TextBlock Text="상호/전화/사업자번호/담당자 검색"
                                       Foreground="#90CAF9"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                            <Button Content="전체 보기"
                                    Style="{StaticResource TradePlanSecondaryButtonStyle}"
                                    Command="{Binding ShowAllCommand}"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding FilteredCustomers}"
                             SelectedItem="{Binding SelectedCustomer}"
                             Background="Transparent"
                             BorderThickness="0"
                             PreviewMouseRightButtonDown="CustomerListBox_PreviewMouseRightButtonDown"
                             MouseDoubleClick="CustomerListBox_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#223754"/>
                                        <Setter Property="Foreground" Value="#4FC3F7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding NameOriginal}" TextWrapping="Wrap" TextTrimming="None"/>
                                    <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="#90CAF9" TextWrapping="Wrap" TextTrimming="None"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="#0D1B2A"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.05*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="0.95*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1A2B4A" CornerRadius="6">
                    <DataGrid x:Name="InvoiceRowsDataGrid"
                              ItemsSource="{Binding InvoiceRows}"
                              SelectedItem="{Binding SelectedInvoiceRow}"
                              IsReadOnly="True"
                              BorderThickness="0"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#2E4060"
                              VerticalGridLinesBrush="#2E4060"
                              CellStyle="{StaticResource InvoiceListCellStyle}"
                              ColumnHeaderStyle="{StaticResource InvoiceListColumnHeaderStyle}"
                              MouseDoubleClick="InvoiceRowsDataGrid_MouseDoubleClick"
                              PreviewMouseRightButtonDown="InvoiceRowsDataGrid_PreviewMouseRightButtonDown"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBalanceCleared}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="전표/내역 열기" Click="OpenSelectedInvoiceMenuItem_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="일자" Binding="{Binding InvoiceDateDisplay}" Width="90"/>
                            <DataGridTextColumn Header="세금계산서" Binding="{Binding TaxInvoiceDisplay}" Width="54">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#A5D6A7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBalanceCleared}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource InvoiceListCellStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PrimaryColumnText}" Width="3*" MinWidth="320">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataContext.InvoicePrimaryColumnHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="유형" Binding="{Binding VoucherTypeDisplay}" Width="86"/>
                            <DataGridTextColumn Header="입고상태" Binding="{Binding PurchaseReceivingDisplay}" Width="90"/>
                            <DataGridTextColumn Header="공급가" Binding="{Binding SupplyAmountDisplay}" Width="84"/>
                            <DataGridTextColumn Header="부가세" Binding="{Binding VatAmountDisplay}" Width="76"/>
                            <DataGridTextColumn Header="합계" Binding="{Binding TotalAmountDisplay}" Width="84"/>
                            <DataGridTextColumn Header="수금액" Binding="{Binding ReceiptAmountDisplay}" Width="76"/>
                            <DataGridTextColumn Header="지급액" Binding="{Binding PaymentAmountDisplay}" Width="76"/>
                            <DataGridTextColumn Header="잔액" Binding="{Binding BalanceAmountDisplay}" Width="76"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" Background="#0D1B2A"/>

                <Border Grid.Row="2" Background="#1A2B4A" CornerRadius="6">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#102039" CornerRadius="6,6,0,0" Padding="10,7">
                            <TextBlock Text="선택 전표 라인 미리보기" Foreground="#4FC3F7" FontWeight="Bold"/>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Padding="10,8" BorderBrush="#2E4060" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="공급가" Foreground="#9FB3C8" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PreviewSupplyAmount, StringFormat=N0}" Width="90" TextAlignment="Right"/>
                                <TextBlock Text="원" Margin="2,0,16,0"/>
                                <TextBlock Text="부가세" Foreground="#9FB3C8" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PreviewVatAmount, StringFormat=N0}" Width="80" TextAlignment="Right"/>
                                <TextBlock Text="원" Margin="2,0,16,0"/>
                                <TextBlock Text="합계" Foreground="#4FC3F7" FontWeight="Bold" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PreviewTotalAmount, StringFormat=N0}" Foreground="#4FC3F7" FontWeight="Bold" Width="100" TextAlignment="Right"/>
                                <TextBlock Text="원" Foreground="#4FC3F7" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding PreviewLines}" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="품목" Binding="{Binding ItemName}" Width="*"/>
                                <DataGridTextColumn Header="규격" Binding="{Binding Specification}" Width="120"/>
                                <DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="70"/>
                                <DataGridTextColumn Header="수량" Binding="{Binding Quantity, StringFormat=N0}" Width="80"/>
                                <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="금액" Binding="{Binding LineAmount, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="비고" Binding="{Binding Remark}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="8" Background="#0D1B2A"/>

            <Border Grid.Column="4"
                    Background="#1A2B4A"
                    BorderBrush="#2E4060"
                    BorderThickness="1"
                    CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#102039" CornerRadius="6,6,0,0" Padding="10,8">
                        <TextBlock Text="거래처 정보" Foreground="#4FC3F7" FontWeight="Bold"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8">
                            <TextBlock Text="상호" FontSize="11" Foreground="#9FB3C8"/>
                            <TextBox Text="{Binding PreviewCustomerName, Mode=OneWay}"
                                     Style="{StaticResource CopyableLookupCustomerNameTextBoxStyle}"
                                     ToolTip="거래처명을 선택해 복사할 수 있습니다."/>
                            <TextBlock Text="사업자번호" FontSize="11" Foreground="#9FB3C8"/>
                            <TextBox Text="{Binding PreviewCustomerBizNumber, Mode=OneWay}" Style="{StaticResource CopyableLookupTextBoxStyle}"/>
                            <TextBlock Text="전화" FontSize="11" Foreground="#9FB3C8"/>
                            <TextBox Text="{Binding PreviewCustomerPhone, Mode=OneWay}" Style="{StaticResource CopyableLookupTextBoxStyle}"/>
                            <TextBlock Text="담당자" FontSize="11" Foreground="#9FB3C8"/>
                            <TextBox Text="{Binding PreviewCustomerContactPerson, Mode=OneWay}" Style="{StaticResource CopyableLookupTextBoxStyle}"/>
                            <TextBlock Text="주소" FontSize="11" Foreground="#9FB3C8"/>
                            <TextBox Text="{Binding PreviewCustomerAddress, Mode=OneWay}" Style="{StaticResource CopyableLookupTextBoxStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="메모" FontSize="11" Foreground="#9FB3C8"/>
                            <TextBox Text="{Binding PreviewCustomerNotes, Mode=OneWay}"
                                     Style="{StaticResource CopyableLookupTextBoxStyle}"
                                     Height="112"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>

                            <Border Margin="0,10,0,0"
                                    Padding="10,8"
                                    Background="#162642"
                                    BorderBrush="#2E4060"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="선수금" Foreground="#9FB3C8" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewCustomerAdvanceBalance, StringFormat={}{0:N0}원}" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="미수금" Foreground="#9FB3C8" Margin="0,6,12,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewCustomerReceivableBalance, StringFormat={}{0:N0}원}" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="미지급금" Foreground="#9FB3C8" Margin="0,6,12,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewCustomerPayableBalance, StringFormat={}{0:N0}원}" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="선지급금" Foreground="#9FB3C8" Margin="0,6,12,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviewCustomerPrepaymentBalance, StringFormat={}{0:N0}원}" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,6,0,0"/>
                                </Grid>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Padding="10,8"
                                    Background="#162642"
                                    BorderBrush="#2E4060"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="최근 렌탈 청구" Foreground="#4FC3F7" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="청구일" Foreground="#9FB3C8" Margin="0,8,12,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewLatestRentalInvoiceDateText}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="거래내역" Foreground="#9FB3C8" Margin="0,6,12,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewLatestRentalItemSummary}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="청구금액 / 미수금" Foreground="#9FB3C8" Margin="0,6,12,0"/>
                                    <Grid Grid.Row="3" Grid.Column="1" MinWidth="180" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PreviewLatestRentalInvoiceAmount, StringFormat={}{0:N0}원}" FontWeight="Bold" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Text=" / " Margin="4,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PreviewRentalOutstandingAmount, StringFormat={}{0:N0}원}" Foreground="#FFCC80" FontWeight="Bold" TextAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
