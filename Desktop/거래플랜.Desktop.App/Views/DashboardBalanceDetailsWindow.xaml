<Window x:Class="거래플랜.Desktop.App.Views.DashboardBalanceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1320" Height="760" MinWidth="1080" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#0B1628" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="Foreground" Value="#DDEBFF"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#455A64"/>
            <Setter Property="BorderBrush" Value="#4C6F91"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowBackground" Value="#E6F0FA"/>
            <Setter Property="AlternatingRowBackground" Value="#D4E2F0"/>
            <Setter Property="Foreground" Value="#071222"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#20344F"/>
            <Setter Property="Foreground" Value="#66D9FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Border" x:Key="PanelBorder">
            <Setter Property="Background" Value="#14243A"/>
            <Setter Property="BorderBrush" Value="#2A4666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style TargetType="Border" x:Key="SummaryCardBorder">
            <Setter Property="Background" Value="#1A2B4A"/>
            <Setter Property="BorderBrush" Value="#2E4060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#DDE7F2"/>
            <Setter Property="Foreground" Value="#071222"/>
            <Setter Property="BorderBrush" Value="#405D7A"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="MaxWidth" Value="150"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="CalendarStyle" Value="{StaticResource GeoraePlanDatePickerCalendarStyle}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Foreground="#5BD4FF"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="#B8C7D8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Style="{StaticResource SummaryCardBorder}">
                            <StackPanel>
                                <TextBlock Text="잔액 합계" Foreground="#9FB3C8" FontSize="11"/>
                                <TextBlock Text="{Binding TotalAmountText}" Foreground="{Binding AccentBrush}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCardBorder}">
                            <StackPanel>
                                <TextBlock Text="거래처" Foreground="#9FB3C8" FontSize="11"/>
                                <TextBlock Text="{Binding CustomerCountText}" Foreground="#EAF2FF" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCardBorder}">
                            <StackPanel>
                                <TextBlock Text="전표" Foreground="#9FB3C8" FontSize="11"/>
                                <TextBlock Text="{Binding InvoiceCountText}" Foreground="#EAF2FF" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="닫기(F12)" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <DataGrid ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="처리" Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsBatchSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="거래처" Binding="{Binding CustomerName}" Width="220"/>
                        <DataGridTextColumn Header="거래처 잔액" Binding="{Binding CustomerBalance, StringFormat={}{0:N0}}" Width="120"/>
                        <DataGridTextColumn Header="작성일" Binding="{Binding InvoiceDateDisplay}" Width="100"/>
                        <DataGridTextColumn Header="전표번호" Binding="{Binding InvoiceNumberDisplay}" Width="130"/>
                        <DataGridTextColumn Header="유형" Binding="{Binding VoucherTypeDisplay}" Width="70"/>
                        <DataGridTextColumn Header="전표내역" Binding="{Binding FirstItemSummary}" Width="*"/>
                        <DataGridTextColumn Header="전표금액" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="110"/>
                        <DataGridTextColumn Header="정산액" Binding="{Binding SettledAmount, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="잔액" Binding="{Binding BalanceAmount, StringFormat={}{0:N0}}" Width="110"/>
                        <DataGridTextColumn Header="담당지점" Binding="{Binding ResponsibleOfficeCode}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding ProcessActionText}" FontSize="21" FontWeight="Bold" Foreground="#5BD4FF"/>
                        <TextBlock Text="선택한 전표에 수금/지급 내역을 추가해 잔액을 처리합니다." Foreground="#B8C7D8" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="선택 거래처" Foreground="#9FB3C8" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedRow.CustomerName, FallbackValue=전표를 선택하세요}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,12"/>

                            <TextBlock Text="전표번호 / 내역" Foreground="#9FB3C8" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedRow.InvoiceNumberDisplay}" Foreground="#EAF2FF" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding SelectedRow.FirstItemSummary}" Foreground="#B8C7D8" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="전표금액" Foreground="#9FB3C8" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedRow.TotalAmount, StringFormat={}{0:N0}원}" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="남은 잔액" Foreground="#9FB3C8" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedRow.BalanceAmount, StringFormat={}{0:N0}원}" Foreground="{Binding AccentBrush}" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="처리일" Foreground="#9FB3C8" FontSize="11" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding ProcessDate, Mode=TwoWay}" Margin="0,0,0,12">
                                <DatePicker.Resources>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource UnifiedDatePickerButtonStyle}"/>
                                </DatePicker.Resources>
                            </DatePicker>

                            <TextBlock Text="처리금액" Foreground="#9FB3C8" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ProcessAmountText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" Margin="0,0,0,12"/>

                            <TextBlock Text="메모" Foreground="#9FB3C8" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ProcessNote, UpdateSourceTrigger=PropertyChanged}" MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True"/>

                            <Border Background="#122038"
                                    BorderBrush="#2E4060"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,12,0,0">
                                <TextBlock Text="{Binding CheckedRowsSummaryText}"
                                           Foreground="#B8C7D8"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button Content="{Binding ProcessActionText}"
                                Command="{Binding ProcessSelectedBalanceCommand}"
                                Background="#00897B"
                                Margin="0,0,0,8"/>
                        <Button Content="{Binding ProcessFullActionText}"
                                Command="{Binding ProcessSelectedFullBalanceCommand}"
                                Background="#1B5E20"
                                Margin="0,0,0,8"/>
                        <Button Content="체크 합계 입력"
                                Command="{Binding FillCheckedBalanceAmountCommand}"
                                IsEnabled="{Binding HasCheckedRows}"
                                Background="#455A64"
                                Margin="0,0,0,8"/>
                        <Button Content="체크 전표 일괄 처리"
                                Command="{Binding ProcessCheckedBalancesCommand}"
                                IsEnabled="{Binding HasCheckedRows}"
                                Background="#00695C"
                                Margin="0,0,0,8"/>
                        <TextBlock Text="저장 후 목록과 메인 요약 금액이 다시 계산됩니다."
                                   Foreground="#9FB3C8"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0E1D31" BorderBrush="#2A4666" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#B8C7D8"/>
        </Border>
    </Grid>
</Window>
