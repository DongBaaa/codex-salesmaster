<Window x:Class="거래플랜.Desktop.App.Views.StartupLoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="거래플랜 - 시작 중"
        Width="440"
        Height="190"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="True"
        Background="#0B1F36">
    <Border Margin="1"
            Padding="30,26"
            Background="#10233D"
            BorderBrush="#2C476A"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="거래플랜"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#4FC3F7"/>
                <TextBlock Text="업무 환경을 준비하고 있습니다."
                           Margin="0,7,0,0"
                           FontSize="13"
                           Foreground="#CFD8E3"/>
            </StackPanel>

            <ProgressBar Grid.Row="1"
                         Height="7"
                         Margin="0,24,0,0"
                         IsIndeterminate="True"
                         Foreground="#42A5F5"
                         Background="#1A3555"
                         BorderThickness="0"/>

            <TextBlock Grid.Row="2"
                       Margin="0,13,0,0"
                       Text="로컬 데이터와 설정을 확인하는 중입니다. 잠시만 기다려 주세요."
                       FontSize="12"
                       Foreground="#90A4B8"/>
        </Grid>
    </Border>
</Window>
