<Window x:Class="거래플랜.Desktop.App.Views.RentalLegacyDraftRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:거래플랜.Desktop.App.Infrastructure"
        infra:ResponsiveWindowBehavior.IsGlobalLayoutExcluded="True"
        infra:ResponsiveWindowBehavior.IsEnabled="False"
        Title="이전 렌탈 임시본 확인" Width="680" Height="470" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource TradePlanWindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="임시본의 업체를 확인해 주세요" Style="{StaticResource TradePlanWindowTitleStyle}"/>
                <TextBlock Text="이전 버전 임시본에는 업체 정보가 없습니다. 아래 내용을 확인하고, 자료가 속한 업체를 선택한 상태에서 복원해 주세요. 다른 업체 자료라면 취소 후 환경설정에서 업체를 바꿔 주세요."
                           Style="{StaticResource TradePlanWindowSubtitleStyle}"/>
                <Border Style="{StaticResource TradePlanSubToolbarStyle}" Margin="0,12,0,12">
                    <StackPanel>
                        <TextBlock Text="복원할 업체" Foreground="{StaticResource TradePlanMutedTextBrush}"/>
                        <TextBlock Text="{Binding TargetBusinessLabel}" Foreground="{StaticResource TradePlanTextBrush}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <TextBlock Text="임시본 거래처" Foreground="{StaticResource TradePlanMutedTextBrush}"/>
                        <TextBlock Text="{Binding CustomerName}" Foreground="{StaticResource TradePlanTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <TextBlock Text="입력된 지점 (업체 확인 근거로 사용하지 않음)" Foreground="{StaticResource TradePlanMutedTextBrush}"/>
                        <TextBlock Text="{Binding OfficeHint}" Foreground="{StaticResource TradePlanTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <CheckBox x:Name="OwnershipConfirmed" Content="이 임시본이 위 업체의 자료임을 확인했습니다." Foreground="{StaticResource TradePlanTextBrush}"/>
                <TextBlock Text="원문은 보관됩니다. 복원은 편집 화면에만 적용되며, 업무 데이터는 저장 버튼을 눌러야 반영됩니다."
                           Style="{StaticResource TradePlanWindowSubtitleStyle}" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="이 업체로 복원" Style="{StaticResource TradePlanPrimaryButtonStyle}" Margin="0,0,8,0"
                    IsEnabled="{Binding IsChecked, ElementName=OwnershipConfirmed}" Click="Restore_Click"/>
            <Button Content="취소" Style="{StaticResource TradePlanSecondaryButtonStyle}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
