<Window x:Class="거래플랜.Desktop.App.Views.ServerIntegrityResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="무결성 문제 해결"
        Width="940"
        Height="720"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0B1628"
        KeyDown="Window_KeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1A2B4A"
                BorderBrush="#2E4060"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="무결성 문제 해결"
                           Foreground="#4FC3F7"
                           FontSize="24"
                           FontWeight="Bold"/>
                <TextBlock Text="선택한 상세 항목의 원인과 해결 방법을 확인하고, 안전한 경우 기존 편집 화면으로 이동합니다."
                           Foreground="#9FB3C8"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="#1A2B4A"
                        BorderBrush="#2E4060"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="문제 요약" Foreground="#4FC3F7" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ProblemExplanation}" Foreground="#EAF2FF" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SeverityText, StringFormat=심각도: {0}}" Foreground="#FFCC80" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A2B4A"
                        BorderBrush="#2E4060"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="대상" Foreground="#9FB3C8" Margin="0,4,12,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.EntityType}" Foreground="#EAF2FF" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="주요 정보" Foreground="#9FB3C8" Margin="0,4,12,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.PrimaryText}" Foreground="#EAF2FF" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Text="보조 정보" Foreground="#9FB3C8" Margin="0,4,12,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail.SecondaryText}" Foreground="#EAF2FF" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="3" Text="참조" Foreground="#9FB3C8" Margin="0,4,12,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail.ReferenceText}" Foreground="#EAF2FF" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="4" Text="범위" Foreground="#9FB3C8" Margin="0,4,12,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Detail.ScopeText}" Foreground="#EAF2FF" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="5" Text="상세" Foreground="#9FB3C8" Margin="0,4,12,0"/>
                        <TextBox Grid.Row="5"
                                 Grid.Column="1"
                                 Text="{Binding Detail.DetailText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinWidth="0"
                                 MinHeight="76"
                                 MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>

                <Border Background="#102039"
                        BorderBrush="#2E4060"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="지금 무엇을 해야 하나요?" Foreground="#4FC3F7" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SuggestedAction}" Foreground="#EAF2FF" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="수정한 뒤 원본 편집창을 닫으면 이 문제를 자동으로 다시 검사합니다."
                                   Foreground="#9FB3C8" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#3A260F"
                        BorderBrush="#A66A1F"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <TextBlock Text="{Binding ActionAvailabilityText}" Foreground="#FFD59A" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="이 해결창은 임의로 서버 데이터를 변경하지 않으며, 기존 화면의 권한·저장·동기화 검사를 그대로 사용합니다."
                       Foreground="#9FB3C8"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="{Binding ActionButtonText}"
                        Style="{StaticResource TradePlanEditButtonStyle}"
                        IsEnabled="{Binding CanOpenTarget}"
                        Click="OpenTargetButton_Click"
                        Margin="0,0,6,0"/>
                <Button Content="수정 후 다시 검사"
                        Style="{StaticResource TradePlanSecondaryButtonStyle}"
                        Click="RecheckButton_Click"
                        Margin="0,0,6,0"/>
                <Button Content="닫기(F12)"
                        Style="{StaticResource TradePlanSecondaryButtonStyle}"
                        Click="CloseButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
