<Window x:Class="거래플랜.Desktop.App.Views.AuditLogLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:거래플랜.Desktop.App.Converters"
        Title="작업 이력 조회"
        Width="1600"
        Height="880"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#151F2E"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <conv:NullableDateOnlyConverter x:Key="NullableDateOnlyConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="FontFamily" Value="맑은 고딕"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#D9E6F5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="BorderBrush" Value="#2E4060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4FC3F7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AuditJsonTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#102039"/>
            <Setter Property="Foreground" Value="#DDEBFF"/>
            <Setter Property="CaretBrush" Value="#4FC3F7"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#D9E6F5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#2E4060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4FC3F7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#D9E6F5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#2E4060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="MaxWidth" Value="150"/>
            <Setter Property="CalendarStyle" Value="{StaticResource GeoraePlanDatePickerCalendarStyle}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4FC3F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="#D9E6F5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource TradePlanSecondaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource TradePlanSecondaryBrush}"/>
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="BorderBrush" Value="#2E4060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#223754"/>
                    <Setter Property="BorderBrush" Value="#4FC3F7"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4FC3F7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E2D40"/>
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="BorderBrush" Value="#2E4060"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2E4060"/>
            <Setter Property="AlternatingRowBackground" Value="#223754"/>
            <Setter Property="RowBackground" Value="#1E2D40"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A2B4A"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="BorderBrush" Value="#2E4060"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A4666"/>
                    <Setter Property="Foreground" Value="#EAF2FF"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4FC3F7"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top"
                Background="#1A2B4A"
                BorderBrush="#2E4060"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="작업 이력 조회"
                               Foreground="#4FC3F7"
                               FontSize="28"
                               FontWeight="Bold"/>
                    <TextBlock Text="현재 계정의 데이터 범위 안에서 사용자 작업과 변경 전후 JSON을 읽기 전용으로 확인합니다."
                               Foreground="#B8C7D8"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#DDEBFF"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LimitStatusText}"
                               Foreground="#FFCC80"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,10"/>
                    <Button Content="닫기(F12)"
                            Style="{StaticResource TradePlanSecondaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#122038"
                BorderBrush="#2E4060"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Bottom">
                <StackPanel Width="150" Margin="0,0,12,0">
                    <TextBlock Text="시작 날짜" Foreground="#9FB3C8" FontSize="11" Margin="0,0,0,10"/>
                    <DatePicker SelectedDate="{Binding FilterFrom, Converter={StaticResource NullableDateOnlyConverter}, Mode=TwoWay}"
                                SelectedDateFormat="Short">
                        <DatePicker.Resources>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource UnifiedDatePickerButtonStyle}"/>
                        </DatePicker.Resources>
                    </DatePicker>
                </StackPanel>

                <StackPanel Width="150" Margin="0,0,12,0">
                    <TextBlock Text="종료 날짜" Foreground="#9FB3C8" FontSize="11" Margin="0,0,0,10"/>
                    <DatePicker SelectedDate="{Binding FilterTo, Converter={StaticResource NullableDateOnlyConverter}, Mode=TwoWay}"
                                SelectedDateFormat="Short">
                        <DatePicker.Resources>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource UnifiedDatePickerButtonStyle}"/>
                        </DatePicker.Resources>
                    </DatePicker>
                </StackPanel>

                <StackPanel Width="160" Margin="0,0,12,0">
                    <TextBlock Text="사용자" Foreground="#9FB3C8" FontSize="11" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding UsernameFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="사용자 ID 일부를 입력합니다."/>
                </StackPanel>

                <StackPanel Width="190" Margin="0,0,12,0">
                    <TextBlock Text="엔티티 종류" Foreground="#9FB3C8" FontSize="11" Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding EntityOptions}"
                              SelectedItem="{Binding SelectedEntityOption}"/>
                </StackPanel>

                <StackPanel Width="160" Margin="0,0,12,0">
                    <TextBlock Text="동작" Foreground="#9FB3C8" FontSize="11" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Create, Update, Delete, Restore 등 동작 일부를 입력합니다."/>
                </StackPanel>

                <StackPanel Width="300" Margin="0,0,12,0">
                    <TextBlock Text="거래처/전표/자산 식별 텍스트" Foreground="#9FB3C8" FontSize="11" Margin="0,0,0,10"/>
                    <TextBox x:Name="SearchTextBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="거래처명, 사업자번호, 전표번호, 품목, 관리번호, 장비번호 등으로 검색합니다."/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="조회"
                            Style="{StaticResource TradePlanSecondaryButtonStyle}"
                            Command="{Binding SearchCommand}"
                            IsEnabled="{Binding CanLookupAuditLogs}"
                            IsDefault="True"
                            Margin="0,0,10,0"/>
                    <Button Content="조건 초기화"
                            Command="{Binding ClearFiltersCommand}"
                            IsEnabled="{Binding CanLookupAuditLogs}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1A2B4A"
                    BorderBrush="#2E4060"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <DataGrid x:Name="AuditLogsDataGrid"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              ClipboardCopyMode="IncludeHeader"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시간" Binding="{Binding CreatedAtText}" Width="150"/>
                            <DataGridTextColumn Header="사용자" Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="지점" Binding="{Binding OfficeCode}" Width="100"/>
                            <DataGridTextColumn Header="엔티티" Binding="{Binding EntityDisplayName}" Width="150"/>
                            <DataGridTextColumn Header="동작" Binding="{Binding Action}" Width="150"/>
                            <DataGridTextColumn Header="식별 대상" Binding="{Binding TargetText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{Binding EmptyMessage}"
                               Foreground="#9FB3C8"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#1A2B4A"
                    BorderBrush="#2E4060"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="선택 상세"
                               Foreground="#4FC3F7"
                               FontSize="15"
                               FontWeight="Bold"/>

                    <Border Grid.Row="1"
                            Background="#14243A"
                            BorderBrush="#2A4666"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRow.DetailHeader}"
                                       Foreground="#DDEBFF"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedRow.TargetText}"
                                       Foreground="#B8C7D8"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding SelectedRow.DetailMetadata}"
                                       Foreground="#9FB3C8"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="#122038"
                                    BorderBrush="#2E4060"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="변경 전 JSON" Foreground="#5BD4FF" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="복사"
                                                Padding="12,7"
                                                Click="CopyBeforeJsonButton_Click"/>
                                    </Grid>
                                    <TextBox x:Name="BeforeJsonTextBox"
                                             Grid.Row="1"
                                             Style="{StaticResource AuditJsonTextBoxStyle}"
                                             Text="{Binding SelectedRow.BeforeJsonText, Mode=OneWay}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Background="#122038"
                                    BorderBrush="#2E4060"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="변경 후 JSON" Foreground="#5BD4FF" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="복사"
                                                Padding="12,7"
                                                Click="CopyAfterJsonButton_Click"/>
                                    </Grid>
                                    <TextBox x:Name="AfterJsonTextBox"
                                             Grid.Row="1"
                                             Style="{StaticResource AuditJsonTextBoxStyle}"
                                             Text="{Binding SelectedRow.AfterJsonText, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Text="왼쪽 목록에서 작업 이력을 선택하면 변경 전후 JSON을 확인하고 복사할 수 있습니다."
                                   Foreground="#9FB3C8"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsSelectionEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
