<Application x:Class="거래플랜.Desktop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:거래플랜.Desktop.App.Converters"
             xmlns:infra="clr-namespace:거래플랜.Desktop.App.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/TradePlanDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="FullTextLeftContentTemplate">
            <TextBlock Text="{Binding Mode=OneWay}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       TextAlignment="Left"/>
        </DataTemplate>
        <DataTemplate x:Key="FullTextCenterContentTemplate">
            <TextBlock Text="{Binding Mode=OneWay}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       TextAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="FullTextRightContentTemplate">
            <TextBlock Text="{Binding Mode=OneWay}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       TextAlignment="Right"/>
        </DataTemplate>
        <infra:FullTextContentTemplateSelector x:Key="FullTextLeftContentTemplateSelector"
                                               StringTemplate="{StaticResource FullTextLeftContentTemplate}"/>
        <infra:FullTextContentTemplateSelector x:Key="FullTextCenterContentTemplateSelector"
                                               StringTemplate="{StaticResource FullTextCenterContentTemplate}"/>
        <infra:FullTextContentTemplateSelector x:Key="FullTextRightContentTemplateSelector"
                                               StringTemplate="{StaticResource FullTextRightContentTemplate}"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:DecimalToStringConverter x:Key="DecimalToString"/>
        <conv:DateOnlyConverter x:Key="DateOnlyConverter"/>
        <Style TargetType="{x:Type Window}">
            <Setter Property="infra:ResponsiveWindowBehavior.IsEnabled" Value="True"/>
            <Setter Property="infra:FullTextLayoutBehavior.IsEnabled" Value="True"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style TargetType="AccessText">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="Padding" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="ContentTemplateSelector" Value="{StaticResource FullTextRightContentTemplateSelector}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <!-- 상세 편집 폼은 좁은 패널에서도 전역 입력 컨트롤의 기본 최소폭(180)을
             상속하지 않고 현재 열의 가용 너비 안에서 축소됩니다. -->
        <Style x:Key="ResponsiveDetailTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MaxWidth" Value="Infinity"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="ResponsiveDetailComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MaxWidth" Value="Infinity"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="ResponsiveDetailDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MaxWidth" Value="Infinity"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <!-- 우측 상세/본문 폼의 너비를 세로 스크롤바를 제외한 실제 viewport에 맞춥니다. -->
        <Style x:Key="ResponsiveDetailScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="infra:ResponsiveDetailViewport.ConstrainContentWidth" Value="True"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplateSelector" Value="{StaticResource FullTextLeftContentTemplateSelector}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="ContentTemplateSelector" Value="{StaticResource FullTextLeftContentTemplateSelector}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplateSelector" Value="{StaticResource FullTextCenterContentTemplateSelector}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="HeaderTemplateSelector" Value="{StaticResource FullTextLeftContentTemplateSelector}"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="HeaderTemplateSelector" Value="{StaticResource FullTextLeftContentTemplateSelector}"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="ContentTemplateSelector" Value="{StaticResource FullTextLeftContentTemplateSelector}"/>
            <Setter Property="MaxWidth" Value="640"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowHeight" Value="NaN"/>
            <Setter Property="ColumnHeaderHeight" Value="NaN"/>
            <Setter Property="MinRowHeight" Value="32"/>
        </Style>
        <!-- 메인 거래내역의 실제 DataGrid 행 크기 계약입니다.
             메인 창의 로컬 DataGrid 스타일이 사용하던 WPF 기본 최소값(0)을 명시해
             판매 세부내역과 품목 검색 목록도 같은 Auto 계산 결과를 공유합니다. -->
        <Style x:Key="MainTransactionDataGridStyle" TargetType="DataGrid">
            <Setter Property="RowHeight" Value="NaN"/>
            <Setter Property="MinRowHeight" Value="0"/>
        </Style>
        <!-- 메인 거래내역처럼 행 높이를 콘텐츠의 한 줄 높이로 자동 계산한다.
             고정 Height/MinHeight를 두지 않아 판매 표도 동일한 기준을 사용한다. -->
        <Style x:Key="MainTransactionDataRowStyle" TargetType="DataGridRow">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="ContentTemplateSelector" Value="{StaticResource FullTextCenterContentTemplateSelector}"/>
        </Style>
        <Style x:Key="GeoraePlanDatePickerCalendarStyle" TargetType="{x:Type Calendar}">
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="MinWidth" Value="320"/>
            <Setter Property="MinHeight" Value="280"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="MaxWidth" Value="150"/>
            <Setter Property="CalendarStyle" Value="{StaticResource GeoraePlanDatePickerCalendarStyle}"/>
        </Style>
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,0,4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type Calendar}" BasedOn="{StaticResource GeoraePlanDatePickerCalendarStyle}"/>
        <Style TargetType="{x:Type CalendarItem}">
            <Setter Property="MinWidth" Value="320"/>
            <Setter Property="MinHeight" Value="260"/>
            <Setter Property="Resources">
                <Setter.Value>
                    <ResourceDictionary>
                        <!--
                            DatePicker 본문에는 드롭다운 버튼 폭을 30px로 고정하는 Button 스타일을 넣어 사용한다.
                            이 스타일이 달력 팝업 내부의 월/년도 헤더 버튼까지 전파되면 "2026년 6월"이
                            "2026"처럼 잘리므로, CalendarItem 내부에서는 버튼 폭 제한을 다시 해제한다.
                        -->
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="FontFamily" Value="Malgun Gothic"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </ResourceDictionary>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UnifiedDatePickerButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="GeoraePlanDataGridCellFocusVisualStyle" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border BorderBrush="#4FC3F7" BorderThickness="1" Background="Transparent" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GeoraePlanDataGridCellFocusVisualStyle}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#90CAF9"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="#5EAEEB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource TradePlanSecondaryButtonStyle}">
            <Setter Property="FontFamily" Value="맑은 고딕"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplateSelector" Value="{StaticResource FullTextCenterContentTemplateSelector}"/>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
